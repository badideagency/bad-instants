<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   ExtensionBundleId="com.badidea.myinstants"
                   ExtensionBundleVersion="0.3.0"
                   ExtensionBundleName="MyInstants"
                   Version="12.0">
    <ExtensionList>
        <Extension Id="com.badidea.myinstants.panel" Version="0.3.0"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PPRO" Version="[26.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="12.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.badidea.myinstants.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <!-- Siteye panelin kendi Chromium'uyla (fetch) istek atabilmek için: CORS kapalı -->
                        <Parameter>--disable-web-security</Parameter>
                        <!-- Adobe'nin CEP 11+ için önerdiği ayar (başka sitelerle ilgili pencere/çerçeve sorunları) -->
                        <Parameter>--disable-site-isolation-trials</Parameter>
                        <!-- Oturum çerezleri panel kapanınca silinmesin (Cloudflare doğrulaması korunsun) -->
                        <Parameter>--persist-session-cookies</Parameter>
                        <!-- Fareyle üstüne gelince (tıklamadan) önizleme çalabilmek için -->
                        <Parameter>--autoplay-policy=no-user-gesture-required</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>MyInstants</Menu>
                    <Geometry>
                        <Size>
                            <Height>600</Height>
                            <Width>340</Width>
                        </Size>
                        <MinSize>
                            <Height>240</Height>
                            <Width>240</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>3000</Height>
                            <Width>2000</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
